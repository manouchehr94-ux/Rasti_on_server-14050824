[Unit]
Description=Reconcile RastiSi administrator media aliases
After=local-fs.target

[Service]
Type=oneshot
User=rastisi-media-aliases
Group=rastisi-media-aliases
WorkingDirectory=/srv/rastisi/current/app
EnvironmentFile=/etc/rastisi/media-aliases.env
ExecStart=/srv/rastisi/current/venv/bin/python manage.py sync_media_aliases --alias-root /srv/rastisi-operator/media-by-name --apply
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/rastisi-operator/media-by-name
TimeoutStartSec=60
